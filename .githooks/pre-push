#!/usr/bin/env bash
# Check each distinct pushed commit, never the current working tree.
# Activate with: git config core.hooksPath .githooks
# Local hooks are bypassable; receiving-side CI remains the enforcement point.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Git exports repository-local variables to hooks. They must not make commands
# executed in the detached worktree refer back to the user's index/worktree.
while read -r variable; do
    unset "$variable"
done < <(git rev-parse --local-env-vars)

temporary=''
cleanup() {
    status=$?
    trap - EXIT
    if [ -n "$temporary" ]; then
        git worktree remove --force "$temporary/tree" >/dev/null 2>&1 || true
        rm -rf -- "$temporary"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

seen=' '
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "$local_sha" in
        *[!0]*) ;;
        *) continue ;; # deletion
    esac
    # Peel annotated tags. Refuse non-commit objects rather than silently
    # reporting a successful manuscript build for an uncheckable target.
    if ! commit=$(git rev-parse --verify "$local_sha^{commit}"); then
        echo "pre-push: $local_ref does not identify a commit; refusing push." >&2
        exit 1
    fi
    case "$seen" in
        *" $commit "*) continue ;;
    esac
    seen="$seen$commit "
    temporary=$(mktemp -d "${TMPDIR:-/tmp}/proof-pre-push.XXXXXXXX")
    git -c core.hooksPath=/dev/null worktree add --quiet --detach "$temporary/tree" "$commit" </dev/null
    echo "pre-push: make all at $commit ($local_ref)"
    # Never let a build consume subsequent ref records from the hook stdin.
    if ! (cd "$temporary/tree" && make all </dev/null); then
        echo "pre-push: pushed commit failed; working-tree edits were not used." >&2
        echo "          Fix and commit, or deliberately bypass with --no-verify." >&2
        exit 1
    fi
    git worktree remove --force "$temporary/tree"
    rmdir "$temporary"
    temporary=''
done
